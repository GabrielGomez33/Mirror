# ============================================================================
# Mirror client (Vite) environment  —  template
# ----------------------------------------------------------------------------
# Vite BAKES these into the bundle at BUILD time (import.meta.env.*), so the
# STAGING build must be built with the staging values — the same dist cannot
# serve both environments. In CI they come from GitHub secrets per environment.
# BASE_URL / DEV are Vite built-ins (not set here).
# ============================================================================

# API origin the client calls. Empty string = same-origin (relative /mirror/api).
# PRODUCTION: https://www.theundergroundrailroad.world  (or "" for same-origin)
# STAGING:    the staging origin, e.g. https://staging.theundergroundrailroad.world
VITE_API_URL=

# WebSocket origin (groups/chat). Derived from VITE_API_URL when unset.
# STAGING: the staging wss:// origin if not same-origin.
VITE_WS_URL=

# Surfaced as the in-app build/version label.
VITE_APP_VERSION=dev

# DINA user id the client addresses for analysis (integer).
VITE_DINA_USER_ID=

# PayPal — use SANDBOX credentials for staging, LIVE only for production.
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_PLAN_ID=
