+-- ============================================================================
+-- 018_marketing_waitlist.sql
+-- ----------------------------------------------------------------------------
+-- Persistence for the public marketing waitlist / newsletter signup surfaced
+-- on the landing page (POST /mirror/api/waitlist).
+--
+-- This is an UNAUTHENTICATED endpoint so the guardrails live in code + schema:
+--   * `email` is the natural key — UNIQUE, so a repeat signup from the same
+--     address is a no-op at the DB layer (INSERT ... ON DUPLICATE KEY UPDATE).
+--   * `source` tags where the signup came from ("landing", "app", "footer",
+--     etc.) so we can measure which surface converts.
+--   * `ip_truncated` is /24 for IPv4 or /48 for IPv6 (see truncateIp() in
+--     controllers/waitlistController.ts) — enough for abuse triage, not
+--     enough to be a precise locator.
+--   * `user_agent` is truncated to 500 chars so a pathological UA can't
+--     bloat the row.
+--   * `status` is an ENUM so the operator dashboard can filter on it.
+--   * `confirmed_at` and `unsubscribed_at` are timestamps rather than
+--     booleans so we retain WHEN, not just IF.
+--   * `metadata` is JSON for forward-compat (referrer, campaign, utm_*).
+--   * All CREATE statements are idempotent (IF NOT EXISTS) and safe to
+--     replay.
+--
+-- MySQL 8.0+. Charset utf8mb4 to match every other table in this schema.
+-- ============================================================================
+
+CREATE TABLE IF NOT EXISTS marketing_waitlist (
+  id               BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
+
+  -- Normalised, lower-cased, trimmed email. UNIQUE — one row per address.
+  email            VARCHAR(254)    NOT NULL,
+
+  -- Where the signup came from. Free-form but bounded; suggested values:
+  -- "landing", "app-footer", "post-purchase", "webinar".
+  source           VARCHAR(64)     NOT NULL DEFAULT 'landing',
+
+  -- Coarse IP for abuse triage. Never store the precise IP.
+  ip_truncated     VARCHAR(64)     NULL DEFAULT NULL,
+
+  -- Truncated user-agent (bounded so a hostile UA cannot bloat the row).
+  user_agent       VARCHAR(500)    NULL DEFAULT NULL,
+
+  -- Lifecycle state. `pending` is the default; `confirmed` after a
+  -- double-opt-in confirmation click; `unsubscribed` after opt-out.
+  status           ENUM('pending','confirmed','unsubscribed','bounced')
+                                   NOT NULL DEFAULT 'pending',
+
+  -- Timestamps — WHEN, not just IF.
+  created_at       DATETIME(3)     NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
+  confirmed_at     DATETIME(3)     NULL     DEFAULT NULL,
+  unsubscribed_at  DATETIME(3)     NULL     DEFAULT NULL,
+
+  -- Forward-compat freeform (utm_source, utm_campaign, referrer, etc.).
+  metadata         JSON            NULL     DEFAULT NULL,
+
+  PRIMARY KEY (id),
+  UNIQUE KEY uq_marketing_waitlist_email (email),
+  KEY idx_marketing_waitlist_created_at (created_at),
+  KEY idx_marketing_waitlist_status (status),
+  KEY idx_marketing_waitlist_ip_created (ip_truncated, created_at)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
